{
  "name": "jobhunt-hq",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source, Claude Code native job-search kit.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json && pnpm --filter @jobhunt-hq/dashboard typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "jh": "pnpm --filter @jobhunt-hq/core run jh",
    "dev": "pnpm --filter @jobhunt-hq/dashboard dev",
    "build": "pnpm --filter @jobhunt-hq/dashboard build",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "ignore": "^7.0.13",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
